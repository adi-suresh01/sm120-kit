             A,
             B.T,
             out_dtype=out_dtype,
             scale_a=As,
             scale_b=Bs.T,
         )
+        out_features = self.config.weight_shape[0]
+        if output.shape[-1] != out_features:
+            output = output[..., :out_features].contiguous()
+        return output
 
 
